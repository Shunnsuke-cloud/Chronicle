# Neon PostgreSQL connection string. Use sslmode=require.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Optional separate database used by Prisma migrate diff/dev.
SHADOW_DATABASE_URL="postgresql://user:password@host/shadow_database?sslmode=require"

# Public application URL used by Better Auth and the browser client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
