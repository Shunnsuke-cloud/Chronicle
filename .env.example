# Copy to .env.local for development. On Render set these in Environment.
# Runtime: Neon pooled TCP connection; copy the exact URL from Neon, retaining SSL.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require"

# Optional direct (non-pooler) URL for Prisma CLI migrations; otherwise DATABASE_URL is used.
# DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require"

# Optional isolated database/Neon branch for migrate dev. Never use the production DB.
# SHADOW_DATABASE_URL="postgresql://user:password@host/shadow_database?sslmode=require"

# Required in development too. Production requires the public HTTPS origin.
BETTER_AUTH_URL="http://localhost:3000"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace this placeholder; at least 32 characters, no fixed fallback.
BETTER_AUTH_SECRET="replace-with-a-generated-random-secret"
