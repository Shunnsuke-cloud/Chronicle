# Neon PostgreSQL connection string. Keep real values only in .env.local or Vercel.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Optional separate database used by Prisma migrate diff/dev.
SHADOW_DATABASE_URL="postgresql://user:password@host/shadow_database?sslmode=require"

# Local URL. Replace both URLs with the production domain in Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
